  "scope": {
    "include": [
      "数值与分类变量",
      "均值与中位数",
      "方差与标准差",
      "直方图与偏态",
      "四分位数、IQR与箱线图",
      "离群值与稳健性",
      "频数与比例",
      "列联表的分母选择",
      "条形图与分组比较"
    ],
    "exclude": [
      "统计推断",
      "假设检验",
      "回归分析",
      "数据变换",
      "编程练习"
    ]
  },
  "sample_learning_goal": "根据这三份资料生成一份连贯的中文描述性统计复习讲义。面向会基础代数、尚未系统学习统计的读者，围绕如何看懂和概括一组数据展开，讲清每个统计量解决什么问题、如何计算、何时适用及常见误区。连接直观解释、公式与小数据例子，覆盖约定范围，合并资料间重复内容，保留可追溯到文件和页码的来源。只输出这一份讲义。",
  "acceptance_checks": [
    "只生成一份连贯讲义，不机械拼接三份资料",
    "每个核心概念有源文件及页码依据",
    "不把课件封面、署名、许可页当成学习内容",
    "跨课件和教材的概念去重，例子与符号保持一致",
    "准确区分样本方差与总体方差、频数与比例、直方图与条形图",
    "检查课件中以图像保存的公式，不能仅凭抽取文本忽略公式",
    "若生成模拟试卷，另起一次生成，使用新情境和合成数据并独立验算，不复用原题题面",
    "正文、小纸条和导出走同一 Markdown/LaTeX 格式约定"
  ],
