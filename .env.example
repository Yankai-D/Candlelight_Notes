# Model settings saved in the app are written to this local .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
READING_TREE_STARTUP_MODE=adaptive
PORT=5173
# Optional path to a Chinese TTF/OTF/TTC font for styled PDF exports.
# READING_TREE_PDF_FONT=C:/Windows/Fonts/NotoSerifSC-VF.ttf
